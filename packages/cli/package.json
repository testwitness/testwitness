{
  "name": "testwitness",
  "version": "0.1.0",
  "description": "testwitness CLI",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
