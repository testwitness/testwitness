{
  "name": "testwitness-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Did this PR weaken its tests, and did they actually run?",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "vitest run --project fixtures",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "corpus:report": "tsx --conditions=development corpus/runner/report.ts",
    "bundle:action": "node scripts/bundle-action.mjs",
    "gen:docs": "tsx --conditions=development scripts/gen-docs.ts",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testwitness/core": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
