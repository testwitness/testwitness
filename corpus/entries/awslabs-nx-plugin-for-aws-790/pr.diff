+    {
+      name: 'empty test block',
+      testBlock: `test: {},`,
+    },
+  ])(
+    'should add passWithNoTests producing compilable config: $name',
+    async ({ testBlock }) => {
+      tree.write('test/vitest.config.mts', wrapConfig(testBlock));
